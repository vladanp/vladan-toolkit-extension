{
  "name": "vladan-toolkit",
  "description": "A personal Chrome toolkit that grows one feature at a time.",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pnpm typecheck && biome ci .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "pnpm check && pnpm test && pnpm e2e",
    "submit": "wxt submit",
    "icons": "node scripts/generate-icons.ts",
    "store-assets": "node scripts/generate-store-assets.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "^16.56.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^21.0.3",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
