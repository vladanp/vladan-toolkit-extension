{
  "name": "vladan-toolkit",
  "description": "A personal Chrome toolkit that grows one feature at a time.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pnpm typecheck && biome ci .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "pnpm check && pnpm test && pnpm e2e",
    "submit": "wxt submit",
    "icons": "node scripts/generate-icons.ts",
    "store-assets": "node scripts/generate-store-assets.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "18.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "happy-dom": "21.0.4",
    "lefthook": "2.2.2",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  }
}
